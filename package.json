{
  "name": "playwright-enterprise-portfolio",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright & TypeScript SDET Portfolio",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:a11y": "playwright test tests/a11y",
    "test:network": "playwright test tests/network",
    "test:shard": "playwright test --shard=1/2",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "report:show": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:clear": "rm -rf allure-results allure-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "sdet",
    "enterprise-automation",
    "qa"
  ],
  "author": "Ashish",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "ajv": "^8.12.0",
    "allure-commandline": "^2.29.0",
    "allure-playwright": "^3.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-playwright": "^1.6.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
